# /etc/website/website.env – Einstellungen des Website-Backends (640 root:website, nie ins Repo).
SITE_URL=https://__DOMAIN__
WEBSITE_DB=/var/lib/website/website.db
WEBSITE_SECRET=__WIRD_ERZEUGT__

# Versand der Bestätigungsmails über das Postfach bei Strato (Werte im Strato-Kundenbereich prüfen).
# Ohne diese Werte lehnt das Backend Anmeldungen ab, statt Adressen ohne Bestätigung zu sammeln.
SMTP_HOST=smtp.strato.de
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=René Bohm – Endlich Feierabend
MAIL_REPLY_TO=
