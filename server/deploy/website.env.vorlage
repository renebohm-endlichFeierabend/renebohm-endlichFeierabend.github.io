# /etc/website/website.env – Einstellungen des Website-Backends (640 root:website, nie ins Repo).
SITE_URL=https://__DOMAIN__
WEBSITE_DB=/var/lib/website/website.db
WEBSITE_SECRET=__WIRD_ERZEUGT__

# Versand der Bestätigungsmails über das Postfach bei Strato (Werte im Strato-Kundenbereich prüfen).
# Ohne diese Werte lehnt das Backend Anmeldungen ab, statt Adressen ohne Bestätigung zu sammeln.
SMTP_HOST=smtp.strato.de
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=René Bohm – Endlich Feierabend
MAIL_REPLY_TO=

# --- Kursshop (server/kursshop.py): Kauf über Stripe → Einschreibung im Moodle. Werte nie ins Repo.
# Hauptschalter: erst auf 1, wenn Stripe, Moodle-Token und Preise eingetragen sind und die Prüfung passt
# (web.sh kauf-pruefen). Live erst nach Genehmigung der Nebentätigkeit und mit fertigen Rechtstexten.
KURSSHOP_AKTIV=0
# Stripe: zuerst Testmodus (sk_test_…), Webhook-Signaturschlüssel (whsec_…) aus dem Dashboard
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe-Preis-IDs (price_…), Namen siehe server/kursshop.json (stripe_preis_env). Das Abo ist auf /kurse/
# ausgeblendet (sichtbar: false), sein Preis wird erst gebraucht, wenn es angezeigt wird.
STRIPE_PRICE_MOODLE_KURSE_MIT_KI=
STRIPE_PRICE_ABO_ALLE_KURSE=
# optional: Login-Link des Stripe-Kundenportals (https://billing.stripe.com/p/login/…) für Mails an Abo-Kundschaft
STRIPE_PORTAL_LOGIN_URL=
# Moodle-Webservice „Kursverkauf“ (Token aus /var/lib/moodle-kursbau/.kursshop-token)
MOODLE_URL=https://moodle.endlich-feierabend-ki.de
MOODLE_KURSSHOP_TOKEN=
# numerische ID der Kohorte abo-alle-kurse (zum Entfernen nötig; Moodle → Kohorten)
MOODLE_ABO_KOHORTE_ID=1
# Umstellen, sobald Moodle Mails schickt: KURSSHOP_FREI_AKTIV=1, MOODLE_CREATEPASSWORD=1 (dann Backend neu starten)
# 1 = „Kostenlos starten“ (Einstiegskurs) auf /kurse/ zeigen
KURSSHOP_FREI_AKTIV=0
# 1 = Moodle verschickt die Zugangsdaten selbst. 0 = Startpasswort in unserer Bestätigungsmail
MOODLE_CREATEPASSWORD=0
# Bei Erstattung/Rückbuchung automatisch austragen (Standard 1; schlägt es fehl: Mail an Verwaltung). 0 = nur Mail
KURSSHOP_AUSTRAGEN=1
# Aufbewahrung in Jahren [U]: Bestellungen/Zahlungen, Kündigungen und Übriges
KURSSHOP_AUFBEWAHRUNG_BUCHUNG_JAHRE=8
KURSSHOP_AUFBEWAHRUNG_SONST_JAHRE=3
# Benachrichtigungen (neue Käufe, Erstattungen, Kündigungen, Klärungsfälle)
KURSSHOP_ADMIN_MAIL=
